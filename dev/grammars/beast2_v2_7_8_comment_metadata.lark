// Grammar for BEAST2 v2.7.8-style "[&key=value,...]" NEXUS/NEWICK comment
// metadata, mirroring BEAST2's own ANTLR grammar (NewickParser.g4 /
// NewickLexer.g4) as hand-reimplemented in
// dendropy.dataio.nexusprocessing._Beast2V2_7_8_AttribTokenizer.
//
// This is the source grammar for the standalone parser checked in at
// src/dendropy/dataio/_beast2_v2_7_8_lark_standalone.py (regenerated via
// dev/generate_beast2_lark_parser.py); it is not itself imported at
// runtime. See that module's docstring, and
// parse_comment_metadata_beast2_v2_7_8_lark() in nexusprocessing.py, for
// details -- including why the parser must be built with the ``basic``
// (non-contextual) lexer: it is what makes a purely-numeric token lex as
// NUMBER (rather than ASTRING) regardless of grammar position, matching
// ANTLR's own context-free lexing and correctly rejecting numeric-only
// attribute keys (e.g. "&123=5").

start: attribs

attribs: attrib ("," attrib)*
       |

attrib: key "=" value

key: ASTRING  -> key
   | DQSTRING -> key
   | SQSTRING -> key

?value: NUMBER   -> number
      | DQSTRING -> dqstring
      | SQSTRING -> sqstring
      | ASTRING  -> string
      | vector

vector: "{" value ("," value)* "}"

// NUMBER is given higher priority than ASTRING so that, e.g., a bare
// "123" lexes as NUMBER rather than ASTRING (the two terminals otherwise
// tie on match length); DQSTRING/SQSTRING never overlap with either,
// since ASTRING's character class excludes quote characters.
NUMBER.2: /-?(?:(?:0|[1-9]\d*)?\.\d+|(?:0|[1-9]\d*)(?:\.\d*)?)(?:[eE]-?\d+)?/
ASTRING.1: /[a-zA-Z0-9|#*%\/.\-+_&:]+/
DQSTRING: /"[^"]*"/
SQSTRING: /'[^']*'/

%ignore /[ \t\r\n]+/
